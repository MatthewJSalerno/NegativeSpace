__pycache__/
*.pyc

# Engine data — these contain real library paths
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/
volumes/

# Private notes, never pushed: local working notes (*-private.md), review
# documents (ai-reviews/, REVIEW_LOG.md) and assistant memory (ai-memory/), all
# under private/. They quote real library paths, filenames and machine details,
# which CLAUDE.md forbids putting in the repository.
private/
# The same names anywhere else stay ignored too, so a note written to an old
# location can never be committed by accident.
*-private.md
REVIEW_LOG.md
ai-reviews/
ai-memory/
webui/frontend/node_modules/
webui/frontend/dist/
docker/.env
