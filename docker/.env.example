# Copy to docker/.env and set your own paths. docker compose reads docker/.env
# automatically, whether started from the repository root with
# `-f docker/compose.yml` or from inside docker/. docker/.env is git-ignored:
# it holds your machine's paths and never belongs in the repository.
#
# Source and destination must be separate folders, neither inside the other.
# Appdata and backups must be separate too (see README).
SOURCE_DIR=/path/to/your/photos
DEST_DIR=/path/to/organized
APPDATA_DIR=/path/to/appdata
BACKUP_DIR=/path/to/backups

# Run as your own user, so files NegativeSpace writes belong to you: `id -u` / `id -g`.
PUID=1000
PGID=1000

# Optional. Which Undated/<year> folder a photo with no EXIF date lands in is decided
# by its file time in this zone. Unset, the container uses UTC.
# TZ=America/New_York
